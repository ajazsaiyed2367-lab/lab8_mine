<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>All Orders (Admin)</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" type="text/css" href="/css/form.css">
    <style>
      table { border-collapse: collapse; width: 100%; background: white; }
      th, td { border: 1px solid #ccc; padding: 8px 12px; text-align: left; }
      th { background: #eee; }
    </style>
</head>
<body>
  <nav class="top_menu">
     <ul>
       <li><a href="/">Order Form</a></li>
       <li><a href="/submissions">All Orders</a></li>
     <li style="float:right; width:auto; padding:0 15px;">
        <% if (isAdmin) { %>
          Welcome, <%= adminName %> | <a href="/logout">Logout</a>
        <% } else { %>
          <a href="/login">Login</a>
        <% } %>
     </li>
     </ul>
  </nav>

  <section style="padding: 20px;">
    <h2>All Orders (Admin)</h2>

    <% if (error) { %>
      <p style="color: red;"><%= error %></p>
    <% } %>

    <% if (!error && submissions.length === 0) { %>
      <p>No submissions yet.</p>
    <% } %>

    <% if (!error && submissions.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Campus</th>
            <th>Tickets</th>
            <th>Lunch</th>
            <th>Subtotal</th>
            <th>Tax</th>
            <th>Total</th>
            <th>Date Submitted</th>
          </tr>
        </thead>
        <tbody>
          <% submissions.forEach(function(s) { %>
            <tr>
              <td><%= s.name %></td>
              <td><%= s.email %></td>
              <td><%= s.campus %></td>
              <td><%= s.tickets %></td>
              <td><%= s.lunch %></td>
              <td>$<%= s.subtotal.toFixed(2) %></td>
              <td>$<%= s.tax.toFixed(2) %></td>
              <td>$<%= s.total.toFixed(2) %></td>
              <td><%= s.createdAt.toLocaleString() %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </section>
</body>
</html>
